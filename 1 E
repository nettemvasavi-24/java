import java.util.Scanner;

public class EmployeeAttendance {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.print("Enter Employee ID: ");
        int id = sc.nextInt();

        System.out.print("Enter Employee Name: ");
        String name = sc.next();

        int[] attendance = new int[7];

        int present = 0;
        int absent = 0;
        boolean valid = true;

        System.out.println("Enter attendance for 7 days (0 or 1):");

        for (int i = 0; i < 7; i++) {

            attendance[i] = sc.nextInt();

            if (attendance[i] == 1) {
                present++;
            }
            else if (attendance[i] == 0) {
                absent++;
            }
            else {
                valid = false;
            }
        }

        if (!valid) {
            System.out.println("Invalid Attendance Input");
        }
        else {

            double percentage = (present / 7.0) * 100;

            System.out.printf("Attendance = %.2f%%\n", percentage);
            System.out.println("Absent Days = " + absent);

            if (percentage >= 90) {
                System.out.println("Eligible");
            }
            else {
                System.out.println("Not Eligible");
            }
        }

        sc.close();
    }
}
